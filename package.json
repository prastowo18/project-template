{
  "name": "nextjs-standard-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "commit": "cz",
    "commitlint": "commitlint",
    "prepare": "husky",
    "lint:staged": "lint-staged",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "db:seed": "prisma db seed",
    "env:check": "tsx scripts/check-env.ts",
    "auth:generate": "auth generate --config src/server/auth/auth.ts",
    "auth:info": "auth info --config src/server/auth/auth.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.6.25",
    "@neondatabase/serverless": "1.1.0",
    "@prisma/adapter-neon": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@t3-oss/env-nextjs": "0.13.11",
    "better-auth": "1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "shadcn": "^4.16.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "commitizen": "4.3.2",
    "cz-git": "1.13.1",
    "dotenv": "17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "4.23.1",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "packageManager": "pnpm@11.17.0",
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "type": "module"
}
