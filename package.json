{
  "name": "nextjs-standard-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "commit": "cz",
    "commitlint": "commitlint",
    "prepare": "husky",
    "lint:staged": "lint-staged",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "db:seed": "prisma db seed",
    "env:check": "tsx scripts/check-env.ts",
    "auth:generate": "pnpm dlx auth@1.6.25 generate --config src/server/auth/auth.cli.ts --output prisma/auth.generated.prisma --yes",
    "auth:info": "pnpm dlx auth@1.6.25 info --config src/server/auth/auth.cli.ts",
    "authz:check": "tsx scripts/check-authorization.ts",
    "seed:check": "tsx scripts/check-seed-catalog.ts",
    "db:check": "tsx scripts/check-database-connection.ts",
    "db:tables": "tsx scripts/check-database-tables.ts",
    "db:status": "prisma migrate status",
    "seed:verify": "tsx scripts/check-seed-data.ts",
    "auth:schema-check": "tsx scripts/check-auth-schemas.ts",
    "clean": "rm -rf .next coverage playwright-report test-results",
    "typegen": "next typegen",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install chromium",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:run && pnpm build",
    "verify:all": "pnpm verify && pnpm test:e2e",
    "knip": "knip --no-progress",
    "knip:production": "knip --production --no-progress --exclude files,exports,types,binaries",
    "security:audit": "pnpm audit --audit-level high",
    "security:check": "pnpm security:audit && pnpm knip && pnpm knip:production",
    "release:check": "pnpm security:check && pnpm db:validate && pnpm authz:check && pnpm seed:check && pnpm verify:all && pnpm test:e2e:registration",
    "test:e2e:registration": "node scripts/run-registration-e2e.mjs"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.6.25",
    "@hookform/resolvers": "5.6.0",
    "@prisma/adapter-neon": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@t3-oss/env-nextjs": "0.13.11",
    "better-auth": "1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.84.0",
    "server-only": "0.0.1",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.0.5",
    "commitizen": "4.3.2",
    "cz-git": "1.13.1",
    "dotenv": "17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "knip": "^6.31.0",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "4.23.1",
    "typescript": "^5",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "packageManager": "pnpm@11.17.0",
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "type": "module"
}
