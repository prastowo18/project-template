# Neon PostgreSQL pooled connection string.
DATABASE_URL="postgresql://username:password@pooler-hostname/database?sslmode=require"

# Neon PostgreSQL direct connection string untuk migration.
DIRECT_DATABASE_URL="postgresql://username:password@direct-hostname/database?sslmode=require"

# Generate menggunakan:
# openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-output-of-openssl-rand-base64-32"

# URL canonical utama aplikasi.
BETTER_AUTH_URL="http://localhost:3000"

# Default false untuk aplikasi internal/dashboard.
# Aktifkan hanya jika route publik memang boleh diindeks.
SITE_INDEXING_ENABLED="false"

# Default false untuk mencegah registrasi akun publik.
# Aktifkan hanya jika aplikasi menerima pendaftaran mandiri.
PUBLIC_REGISTRATION_ENABLED="false"

# Gunakan hanya ketika environment belum tersedia saat build tertentu.
# Jangan aktifkan pada runtime production normal.
SKIP_ENV_VALIDATION="false"

# Bootstrap superadmin ketika menjalankan pnpm db:seed.
# Kosongkan ketiganya jika belum ingin membuat superadmin.
INITIAL_SUPERADMIN_NAME="Super Administrator"
INITIAL_SUPERADMIN_EMAIL=""
INITIAL_SUPERADMIN_PASSWORD=""

# debug | info | warn | error
LOG_LEVEL="info"

# Isi "standalone" untuk deployment Docker/self-hosted.
# Kosongkan untuk deployment standar seperti Vercel.
NEXT_OUTPUT_MODE=""

# Opsional untuk menonaktifkan telemetry Next.js pada CI/deployment.
NEXT_TELEMETRY_DISABLED="1"
