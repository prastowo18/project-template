# Neon PostgreSQL connection string.
DATABASE_URL="postgresql://username:password@hostname/database?sslmode=require"

# Generate menggunakan:
# openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-output-of-openssl-rand-base64-32"

# URL utama aplikasi.
BETTER_AUTH_URL="http://localhost:3000"

# Gunakan hanya ketika environment belum tersedia saat proses build tertentu.
# Jangan aktifkan pada runtime production normal.
SKIP_ENV_VALIDATION="false"
